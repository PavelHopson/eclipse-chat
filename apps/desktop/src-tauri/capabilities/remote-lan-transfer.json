{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-lan-transfer",
  "description": "Allow only the production Eclipse Chat webview to use the native, confirmation-gated LocalSend bridge.",
  "remote": {
    "urls": ["https://app.star-crm.ru/eclipse-chat/*"]
  },
  "local": false,
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-lan-transfer-status",
    "allow-lan-transfer-scan",
    "allow-lan-transfer-pick-files",
    "allow-lan-transfer-send",
    "allow-lan-transfer-cancel",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
