      "line": "#1C2536",
      "signal": "#6BA3FF",
      "gold": "#D4AF37"
    },
    "light": {
      "background": "#F5F2EB",
      "backgroundAlt": "#EDE9E0",
      "surface": "#FFFFFF",
      "surfaceHover": "#FFFDF8",
      "textPrimary": "#07070A",
      "textSecondary": "#1F1F24",
