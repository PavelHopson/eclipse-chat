{
  "name": "eclipse-chat",
  "version": "1.7.65",
  "private": true,
  "description": "Self-hosted чат: монорепо (сервер, web, shared). Код — поэтапно; см. README.",
  "workspaces": [
    "apps/web",
    "apps/server",
    "apps/desktop",
    "packages/*"
  ],
  "devDependencies": {
    "deepmerge-ts": "8.0.0",
    "prisma": "6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "scripts": {
    "test": "node --test deploy/scripts/ui-shell-contract.test.mjs deploy/scripts/workspace-polish.test.mjs deploy/scripts/task-flow.test.mjs deploy/scripts/conversation-flow.test.mjs deploy/scripts/workspace-navigation.test.mjs && npm run test -w @eclipse-chat/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @eclipse-chat/server",
    "dev:web": "npm run dev -w @eclipse-chat/web",
    "build": "npm run build --workspaces --if-present",
    "security:profile": "node deploy/scripts/security-profile.mjs",
    "security:profile:test": "node --test deploy/scripts/security-profile.test.mjs deploy/scripts/nginx-contract.test.mjs deploy/scripts/voice-ops-security.test.mjs deploy/scripts/ai-gateway-deploy-contract.test.mjs",
    "db:push": "npm run db:push -w @eclipse-chat/server",
    "db:migrate": "npm run db:migrate -w @eclipse-chat/server",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @eclipse-chat/server",
    "db:seed": "npm run db:seed -w @eclipse-chat/server",
    "db:studio": "npm run db:studio -w @eclipse-chat/server"
  }
}
